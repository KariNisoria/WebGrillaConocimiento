@using WebGrillaBlazor.DTOs
@using WebGrillaBlazor.ApiClient
@inject ApiClientGeneric<RolDTO> _apiClient

<EditForm EditContext="@editContext" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Id:</label>
        <label class="col-md-10">
            @if (rol.IdRol > 0)
            {
                <text>@rol.IdRol</text>
            }
            else
            {
                <span class="text-muted fst-italic">Se asignará automáticamente</span>
            }
        </label>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Nombre:</label>
        <div class="col-md-10">
            <TextInput @bind-Value="@rol.Nombre" Placeholder="Ingrese el nombre del rol"></TextInput>
        </div>
    </div>

</EditForm>

<div class="row">
    <div class="col-md-12 text-right">
        <Button Type="ButtonType.Button" Color="ButtonColor.Success" @onclick="GrabarRol">Grabar</Button>
        @if (!_esNuevo)
        {
            <Button Type="ButtonType.Button" Color="ButtonColor.Warning" @onclick="EliminarRol">Eliminar</Button>
        }
        <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="OnClickCallBack"> Cerrar</Button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="row mt-3">
        <Alert Color="AlertColor.Danger">@errorMessage</Alert>
    </div>
}

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallBack { get; set; }
    [Parameter] public RolDTO rol { get; set; }
    private EditContext editContext;

    private string errorMessage = "";
    private bool _esNuevo = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"OnInitializedAsync() idRol: {rol.IdRol}");

        editContext = new EditContext(rol);

        // Determinar si es un registro nuevo (Id = 0) o existente
        _esNuevo = rol.IdRol == 0;

        Console.WriteLine($"OnInitializedAsync() esNuevo: {_esNuevo}");

        await base.OnInitializedAsync();
    }

    public void HandleOnValidSubmit()
    {
        if (editContext.Validate())
        {
            Console.WriteLine("Form submitted successfully");
        }
    }

    private async Task GrabarRol()
    {
        // Validar campos requeridos
        if (string.IsNullOrWhiteSpace(rol.Nombre))
        {
            errorMessage = "Debe ingresar un nombre para el rol";
            return;
        }

        errorMessage = "";

        try
        {
            if (_esNuevo)
            {
                Console.WriteLine("AltaRol()");
                var nuevo = await _apiClient.CreateAsync(rol);
                rol.IdRol = nuevo.IdRol;
                _esNuevo = false;
            }
            else
            {
                Console.WriteLine("ModificarRol()");
                await _apiClient.UpdateAsync(rol.IdRol, rol);
            }

            if (OnClickCallBack.HasDelegate)
            {
                await OnClickCallBack.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task EliminarRol()
    {
        if (_esNuevo || rol.IdRol == 0)
        {
            errorMessage = "No se puede eliminar un registro que no ha sido guardado";
            return;
        }

        try
        {
            Console.WriteLine("EliminarRol()");
            await _apiClient.DeleteAsync(rol.IdRol);

            if (OnClickCallBack.HasDelegate)
            {
                await OnClickCallBack.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar rol: {ex.Message}";
        }
    }
}