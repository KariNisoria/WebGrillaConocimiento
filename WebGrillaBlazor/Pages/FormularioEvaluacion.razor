    private async Task GuardarConocimiento(int idSubtema)
    {
        if (!ValidarValoresValidos(new List<int> { idSubtema }))
        {
            MostrarToast("Debes seleccionar una nota del 0 al 5 tanto para Funcional como para Técnico antes de guardar.", "warning");
            return;
        }

        guardandoConocimiento = true;
        try
        {
            var conocimiento = conocimientos.First(c => c.IdSubtema == idSubtema);
            var conocimientoGuardado = await ConocimientoClient.CrearOActualizarAsync(conocimiento);

            var index = conocimientos.FindIndex(c => c.IdSubtema == idSubtema);
            if (index >= 0) conocimientos[index] = conocimientoGuardado;

            MostrarToast("Conocimiento guardado correctamente", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al guardar el conocimiento: " + ex.Message, "error");
        }
        finally
        {
            guardandoConocimiento = false;
        }
    }

    private async Task GuardarTodoElTema(int idGrillaTema)
    {
        var tema = temasBinarizados.FirstOrDefault(t => t.IdGrillaTema == idGrillaTema);
        if (tema == null) return;

        var subtemasDelTema = tema.Subtemas.Select(s => s.IdSubtema).ToList();

        if (!ValidarValoresValidos(subtemasDelTema))
        {
            MostrarToast($"No se puede guardar el tema '{tema.Nombre}'. Hay subtemas pendientes en N/A (debe seleccionar un valor de 0 a 5).", "warning");
            return;
        }

        guardandoTema = true;
        try
        {
            var conocimientosParaGuardar = conocimientos.Where(c => subtemasDelTema.Contains(c.IdSubtema)).ToList();
            var conocimientosGuardados = await ConocimientoClient.GuardarMultiplesAsync(conocimientosParaGuardar);

            foreach (var conocimientoGuardado in conocimientosGuardados)
            {
                var index = conocimientos.FindIndex(c => c.IdSubtema == conocimientoGuardado.IdSubtema);
                if (index >= 0) conocimientos[index] = conocimientoGuardado;
            }

            MostrarToast($"Tema '{tema.Nombre}' guardado correctamente.", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al guardar el tema: " + ex.Message, "error");
        }
        finally
        {
            guardandoTema = false;
        }
    }
    private async Task VerificarTema(int idGrillaTema)
    {
        if (!esSupervisor)
        {
            MostrarToast("Solo los supervisores pueden verificar valores", "warning");
            return;
        }

        var tema = temasBinarizados.FirstOrDefault(t => t.IdGrillaTema == idGrillaTema);
        if (tema == null) return;

        var subtemasDelTema = tema.Subtemas.Select(s => s.IdSubtema).ToList();
        var conocimientosDelTema = conocimientos
            .Where(c => subtemasDelTema.Contains(c.IdSubtema))
            .ToList();

        // Solo guardar los que tienen valores verificados completos
        var conocimientosVerificados = conocimientosDelTema
            .Where(c => c.ValorFuncionalVerif.HasValue && c.ValorTecnicoVerif.HasValue)
            .ToList();

        if (!conocimientosVerificados.Any())
        {
            MostrarToast($"No hay valores verificados para guardar en el tema '{tema.Nombre}'.", "warning");
            return;
        }

        verificandoTema = true;
        try
        {
            var guardados = await ConocimientoClient.GuardarMultiplesAsync(conocimientosVerificados);
            foreach (var guardado in guardados)
            {
                var index = conocimientos.FindIndex(c => c.IdSubtema == guardado.IdSubtema);
                if (index >= 0) conocimientos[index] = guardado;
            }

            MostrarToast($"Valores verificados del tema '{tema.Nombre}' guardados correctamente.", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al verificar el tema: " + ex.Message, "error");
        }
        finally
        {
            verificandoTema = false;
        }
    }
    private async Task GuardarTodoElProgreso()
    {
        var todosLosSubtemas = grillaSubtemas.Select(s => s.IdSubtema).ToList();

        if (!ValidarValoresValidos(todosLosSubtemas))
        {
            MostrarToast("No se puede guardar todo el progreso. Existen subtemas en 'N/A' que requieren una evaluación entre 0 y 5.", "danger");
            return;
        }

        guardandoTodo = true;
        try
        {
            var conocimientosGuardados = await ConocimientoClient.GuardarMultiplesAsync(conocimientos);
            foreach (var conocimientoGuardado in conocimientosGuardados)
            {
                var index = conocimientos.FindIndex(c => c.IdSubtema == conocimientoGuardado.IdSubtema);
                if (index >= 0) conocimientos[index] = conocimientoGuardado;
            }

            // Cambiar estado a Finalizada (1)
            if (evaluacion != null && evaluacion.Estado == 0)
            {
                var estadoActualizado = await EvaluacionClient.CambiarEstadoAsync(IdEvaluacion, 1);
                if (estadoActualizado != null)
                    evaluacion.Estado = estadoActualizado.Estado;
            }

            MostrarToast("Todo el progreso ha sido guardado correctamente. Estado: Finalizada.", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al guardar el progreso: " + ex.Message, "error");
        }
        finally
        {
            guardandoTodo = false;
        }
    }
    private async Task VerificarTodoElProgreso()
    {
        if (!esSupervisor)
        {
            MostrarToast("Solo los supervisores pueden verificar el progreso", "warning");
            return;
        }

        if (evaluacion != null && evaluacion.Estado == 2)
        {
            bool confirmar = await JS.InvokeAsync<bool>("confirm",
                "Esta evaluación ya se encuentra verificada. Si continúa, se actualizarán los datos y se registrará una nueva fecha de verificación. ¿Desea proceder?");

            if (!confirmar)
                return;
        }

        // Clonamos la lista normalizando los valores -1 a 0 para persistir en BD
        var conocimientosVerificados = conocimientos.Select(c => new ConocimientoRecursoDTO
        {
            IdConocimientoRecurso = c.IdConocimientoRecurso,
            IdSubtema = c.IdSubtema,
            IdRecurso = c.IdRecurso,
            IdEvaluacion = c.IdEvaluacion,
            IdGrilla = c.IdGrilla,
            ValorFuncional = c.ValorFuncional < 0 ? 0 : c.ValorFuncional,
            ValorTecnico = c.ValorTecnico < 0 ? 0 : c.ValorTecnico,
            // Si el valor es null o -1 (N/A), se convierte a 0 para persistir en BD
            ValorFuncionalVerif = (!c.ValorFuncionalVerif.HasValue || c.ValorFuncionalVerif < 0) ? 0 : c.ValorFuncionalVerif,
            ValorTecnicoVerif = (!c.ValorTecnicoVerif.HasValue || c.ValorTecnicoVerif < 0) ? 0 : c.ValorTecnicoVerif
        }).ToList();

        if (!conocimientosVerificados.Any())
        {
            MostrarToast("No hay conocimientos cargados para verificar.", "warning");
            return;
        }

        verificandoTodo = true;
        try
        {
            var guardados = await ConocimientoClient.GuardarMultiplesAsync(conocimientosVerificados);
            foreach (var guardado in guardados)
            {
                var index = conocimientos.FindIndex(c => c.IdSubtema == guardado.IdSubtema);
                if (index >= 0) conocimientos[index] = guardado;
            }

            if (evaluacion != null)
            {
                evaluacion.IdRecursoSupervisor = AuthState.GetCurrentUserId();
                evaluacion.FechaSupervision = DateTime.Now;

                var evaluacionActualizada = await EvaluacionClient.UpdateAsync(IdEvaluacion, evaluacion);
                if (evaluacionActualizada != null)
                {
                    evaluacion.IdRecursoSupervisor = evaluacionActualizada.IdRecursoSupervisor;
                    evaluacion.FechaSupervision = evaluacionActualizada.FechaSupervision;
                }
            }

            if (evaluacion != null && evaluacion.Estado != 2)
            {
                var estadoActualizado = await EvaluacionClient.CambiarEstadoAsync(IdEvaluacion, 2);
                if (estadoActualizado != null)
                    evaluacion.Estado = estadoActualizado.Estado;
            }

            var nombreSupervisor = AuthState.GetUserDisplayName();
            _ = EvaluacionClient.NotificarVerificacionAsync(
                    IdEvaluacion,
                    nombreSupervisor,
                    DateTime.Now);

            MostrarToast("Todo el progreso verificado ha sido guardado. Estado: Verificada.", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al verificar el progreso: " + ex.Message, "error");
        }
        finally
        {
            verificandoTodo = false;
        }
    }
    private void VolverAEvaluaciones()
    {
        Navigation.NavigateTo("evaluaciones");
    }

    private void MostrarToast(string mensaje, string tipo)
    {
        mensajeToast = mensaje;
        tipoToast = tipo;
        mostrarToast = true;
        Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
        {
            mostrarToast = false;
            StateHasChanged();
        }));
    }
    private string GetClaseColorVerificacion(int? valorVerificado, int? valorOriginal)
    {
        // Si no hay valor verificado cargado, no aplicamos color
        if (!valorVerificado.HasValue)
            return string.Empty;

        int verif = valorVerificado.Value;
        int orig = valorOriginal ?? 0;

        if (verif < orig)
        {
            return "bg-danger text-white"; // Pintar celda de rojo si es menor
        }
        else if (verif > orig)
        {
            return "bg-success text-white"; // Pintar celda de verde si es mayor
        }

        return string.Empty; // Si son iguales (verif == orig)
    }
    private bool ValidarValoresValidos(List<int> idSubtemasAValidar)
    {
        foreach (var idSubtema in idSubtemasAValidar)
        {
            var c = conocimientos.FirstOrDefault(x => x.IdSubtema == idSubtema);

            // Rechazar si no existe o si conserva el estado inicial N/A (-1)
            if (c == null || c.ValorFuncional < 0 || c.ValorFuncional > 5 || c.ValorTecnico < 0 || c.ValorTecnico > 5)
            {
                return false;
            }
        }
        return true;
    }
