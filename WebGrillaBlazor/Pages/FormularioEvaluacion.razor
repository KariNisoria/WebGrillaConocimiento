    private async Task OcultarModalFinalizarEvaluacion()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                var modalElement = document.getElementById('modalFinalizarEvaluacion');
                var modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
