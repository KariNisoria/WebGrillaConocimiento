    private async Task CargarConocimientos()
    {
        try
        {
            Console.WriteLine($"Cargando conocimientos para evaluación {IdEvaluacion} y recurso {IdRecurso}");
            conocimientos = await ConocimientoClient.GetConocimientosPorEvaluacionYRecursoAsync(IdEvaluacion, IdRecurso);
            Console.WriteLine($"Conocimientos cargados desde BD: {conocimientos.Count}");

   
            foreach (var st in grillaSubtemas)
            {
                var c = conocimientos.FirstOrDefault(x => x.IdSubtema == st.IdSubtema);
                if (c == null)
                {
                    conocimientos.Add(new ConocimientoRecursoDTO
                    {
                        IdConocimientoRecurso = 0,
                        IdSubtema = st.IdSubtema,
                        IdRecurso = IdRecurso,
                        IdEvaluacion = IdEvaluacion,
                        IdGrilla = evaluacion?.IdGrilla ?? 0,
                        ValorFuncional = -1, // En pantalla se mostrará "N/A"
                        ValorTecnico = -1,
                        ValorFuncionalVerif = -1, // En pantalla se mostrará "N/A"
                        ValorTecnicoVerif = -1
                    });
                }
                else
                {
                    // Si viene de BD como null, lo asignamos en -1 para que la UI muestre "N/A"
                    if (!c.ValorFuncionalVerif.HasValue) c.ValorFuncionalVerif = -1;
                    if (!c.ValorTecnicoVerif.HasValue) c.ValorTecnicoVerif = -1;
                }
            }
