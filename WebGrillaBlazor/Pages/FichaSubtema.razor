@using WebGrillaBlazor.DTOs
@using WebGrillaBlazor.ApiClient
@inject ApiClientSubtema _apiClientSubtema

<EditForm EditContext="@editContext" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Id:</label>
        <label class="col-md-10">
            @if (subtema.IdSubtema > 0)
            {
                <text>@subtema.IdSubtema</text>
            }
            else
            {
                <span class="text-muted fst-italic">Se asignará automáticamente</span>
            }
        </label>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Nombre:</label>
        <div class="col-md-10">
            <TextInput @bind-Value="@subtema.Nombre" Placeholder="Ingrese el nombre"></TextInput>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Orden:</label>
        <div class="col-md-10">
            <NumberInput @bind-Value="@subtema.Orden" Placeholder="Ingrese el Orden"></NumberInput>
        </div>
    </div>

</EditForm>

<div class="row">
    <div class="col-md-12 text-right">
        <Button Type="ButtonType.Button" Color="ButtonColor.Success" @onclick="GrabarSubtema">Grabar</Button>
        @if (!_esNuevo)
        {
            <Button Type="ButtonType.Button" Color="ButtonColor.Warning" @onclick="EliminarSubtema">Eliminar</Button>
        }
        <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="OnClickCallBackSubtema"> Cerrar</Button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="row mt-3">
        <Alert Color="AlertColor.Danger">@errorMessage</Alert>
    </div>
}

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallBackSubtema { get; set; }
    [Parameter] public SubtemaDTO subtema { get; set; }
    private EditContext editContext;

    private string errorMessage = "";
    private bool _esNuevo = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"OnInitializedAsync() idSubtema: {subtema.IdSubtema}");

        editContext = new EditContext(subtema);

        // Determinar si es un registro nuevo (Id = 0) o existente
        _esNuevo = subtema.IdSubtema == 0;

        Console.WriteLine($"OnInitializedAsync() esNuevo: {_esNuevo}");

        await base.OnInitializedAsync();
    }

    public void HandleOnValidSubmit()
    {
        if (editContext.Validate())
        {
            Console.WriteLine("Form submitted successfully");
        }
    }

    private async Task GrabarSubtema()
    {
        // Validar campos requeridos
        if (string.IsNullOrWhiteSpace(subtema.Nombre))
        {
            errorMessage = "Debe ingresar un nombre para el subtema";
            return;
        }

        errorMessage = "";

        try
        {
            if (_esNuevo)
            {
                Console.WriteLine("AltaSubtema()");
                var nuevo = await _apiClientSubtema.AddSubtemaAsync(subtema);
                subtema.IdSubtema = nuevo.IdSubtema;
                _esNuevo = false;
            }
            else
            {
                Console.WriteLine("ModificarSubtema()");
                await _apiClientSubtema.UpdateSubtemaAsync(subtema.IdSubtema, subtema);
            }

            if (OnClickCallBackSubtema.HasDelegate)
            {
                await OnClickCallBackSubtema.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task EliminarSubtema()
    {
        if (_esNuevo || subtema.IdSubtema == 0)
        {
            errorMessage = "No se puede eliminar un registro que no ha sido guardado";
            return;
        }

        try
        {
            Console.WriteLine("EliminarSubtema()");
            await _apiClientSubtema.DeleteSubtemaAsync(subtema.IdSubtema);

            if (OnClickCallBackSubtema.HasDelegate)
            {
                await OnClickCallBackSubtema.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar subtema: {ex.Message}";
        }
    }
}
