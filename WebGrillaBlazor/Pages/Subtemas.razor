    private async Task OnSubtemaDobleClick(GridRowEventArgs<SubtemaDTO> args)
    {
        if (!AuthState.UserHasPermission("SUBTEMAS_WRITE"))
        {
            Console.WriteLine("Sin permisos para editar subtema - doble click ignorado");
            return;
        }

        Console.WriteLine("Evento OnTemaDobleClick");
        var param = new Dictionary<string, object>();
        param.Add("OnClickCallBack", EventCallback.Factory.Create<MouseEventArgs>(this, OnCloseModalEdicionSubtema));
        param.Add("subtema", args.Item);
        await _EdicionSubtema.ShowAsync<FichaSubtema>(title: "Edición Subtema", parameters: param);
    }

    private async Task OnCloseModalAltaSubtema()
    {
        Console.WriteLine("OnCloseModalAltaSubtema()");
        await _AltaSubtema.HideAsync(); // Ocultar el modal de alta
        await RefreshGrid(); // Refrescar la grilla

        // Mostrar mensaje de éxito
        ShowSuccessMessage("¡Subtema agregado exitosamente!");
    }

    private async Task OnCloseModalEdicionSubtema()
    {
        Console.WriteLine("OnCloseModalEdicionSubtema()");
        await _EdicionSubtema.HideAsync(); // Ocultar el formulario de Edicion
        await RefreshGrid(); // Refrescar la grilla

        // Mostrar mensaje de éxito
        ShowSuccessMessage("¡Subtema actualizado exitosamente!");
    }

    private async Task RefreshGrid()
    {
        subtemas = null; // Limpiar la caché local de temas
        await gridSubtema.RefreshDataAsync();
        StateHasChanged(); // Forzar la actualización de la grilla
    }
