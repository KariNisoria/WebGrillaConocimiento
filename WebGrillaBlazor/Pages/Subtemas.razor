    private async Task<GridDataProviderResult<SubtemaDTO>> GetAllSubtemas(GridDataProviderRequest<SubtemaDTO> request)
    {
        Console.WriteLine("GetAllSubtemas");

        if (subtemas is null)
            subtemas = await ApiClient.GetAllSubtemas();

        return await Task.FromResult(request.ApplyTo(subtemas));
    }

    

    private async Task AbrirModalAltaSubtema()
    {
        if (!AuthState.UserHasPermission("SUBTEMAS_WRITE"))
        {
            Console.WriteLine("Sin permisos para crear subtema");
            return;
        }

        Console.WriteLine("Abriendo modal para agregar nuevo subtema");

        // Crear un nuevo tema vacío
        var nuevoSubtema = CreateNuevoSubtema();

        var param = new Dictionary<string, object>();
        param.Add("OnClickCallBack", EventCallback.Factory.Create<MouseEventArgs>(this, OnCloseModalAltaSubtema));
        param.Add("subtema", nuevoSubtema);

        await _AltaSubtema.ShowAsync<FichaSubtema>(title: "Agregar Nuevo Subtema", parameters: param);
    }

