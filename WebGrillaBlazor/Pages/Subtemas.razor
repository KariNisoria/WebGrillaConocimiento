    private SubtemaDTO CreateNuevoSubtema()
    {
        var nuevoSubtema = new SubtemaDTO
        {
            IdSubtema = 0, // Nuevo tema, el ID lo asignará la base de datos
            Nombre = "",
            Orden = (subtemas?.Any() == true) ? subtemas.Max(x => x.Orden) + 1 : 1
        };

        Console.WriteLine($"Nuevo tema creado con orden: {nuevoSubtema.Orden}");
        return nuevoSubtema;
    }

