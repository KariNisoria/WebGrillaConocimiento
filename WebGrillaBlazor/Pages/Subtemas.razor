@page "/subtemas"
@using WebGrillaBlazor.DTOs
@using WebGrillaBlazor.Services
@inject WebGrillaBlazor.ApiClient.ApiClientSubtema ApiClient
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Gestión de Subtemas</PageTitle>

<WebGrillaBlazor.Components.AuthorizeView RedirectToLogin="true">
    @if (!AuthState.UserCanAccess("SUBTEMAS"))
    {
        <div class="alert alert-danger">
            <h4 class="alert-heading">Acceso Denegado</h4>
            <p>No tienes permisos para acceder a la gestión de subtemas.</p>
            <hr>
            <p class="mb-0">
                <strong>Permisos requeridos:</strong> SUBTEMAS_READ<br>
                <strong>Tu rol actual:</strong> @AuthState.CurrentUser?.NombreRol<br>
                Contacta con un administrador si necesitas acceso a esta funcionalidad.
            </p>
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("index"))">
                    <Icon Name="IconName.ArrowLeft" class="me-1" />
                    Volver al Dashboard
                </button>
            </div>
        </div>
        return;
    }

    <div class="container-fluid">
        <!-- Alerta de éxito -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <Alert Color="AlertColor.Success" Dismissible="true" @onclose="ClearSuccessMessage">
                <Icon Name="IconName.Check" class="me-2" />
                @successMessage
            </Alert>
        }

        <div class="row mb-3">
            <div class="col">
                <h3>
                    <Icon Name="IconName.JournalBookmark" class="me-2 text-primary" />
                    Gestión de Temas y Subtemas
                </h3>
                <p class="text-muted">Administrar subtemas para estructurar el conocimiento del sistema</p>
            </div>
            <div class="col-auto">
                @if (AuthState.UserHasPermission("SUBTEMAS_WRITE"))
                {
                    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="AbrirModalAltaSubtema">
                        <Icon Name="IconName.Plus" class="me-1" />
                        Agregar Subtema
                    </Button>
                }
                else
                {
                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" disabled title="Sin permisos de escritura">
                        <Icon Name="IconName.Lock" class="me-1" />
                        Sin permisos
                    </Button>
                }
            </div>
        </div>

        <!-- Grilla de temas -->
        <div class="card">
            <div class="card-body">
                <Grid @ref="gridSubtema"
                      TItem="SubtemaDTO"
                      Class="table table-hover table-bordered table-striped"
                      DataProvider="GetAllSubtemas"
                      AllowPaging="true"
                      PageSize="10"
                      AllowDetailView="true"
                      AllowSorting="true"
                      AllowRowClick="true"
                      OnRowClick="OnRowClick"
                      OnRowDoubleClick="OnSubtemaDobleClick"
                      SelectionMode="GridSelectionMode.Single"
                      Responsive="true">

                    <GridColumns>
                        <GridColumn TItem="SubtemaDTO" HeaderText="ID" PropertyName="IdSubtema" SortKeySelector="item => item.IdSubtema">
                            @context.IdSubtema
                        </GridColumn>

                        <GridColumn TItem="SubtemaDTO" HeaderText="Nombre del Subtema" PropertyName="Descripcion" SortKeySelector="item => item.Nombre">
                            <strong>@context.Nombre</strong>
                        </GridColumn>

                        <GridColumn TItem="SubtemaDTO" HeaderText="Orden" PropertyName="Orden" SortKeySelector="item => item.Orden">
                            <span class="badge bg-secondary">@context.Orden</span>
                        </GridColumn>

                        @if (AuthState.UserHasPermission("SUBTEMAS_WRITE"))
                        {
                            <GridColumn TItem="SubtemaDTO" HeaderText="Acciones">
                                <Button Color="ButtonColor.Primary" Size="ButtonSize.ExtraSmall" @onclick="() => EditarSubtema(context)">
                                    <Icon Name="IconName.Pencil" />
                                </Button>
                            </GridColumn>
                        }
                    </GridColumns>

                    <GridDetailView TItem="SubtemaDTO">
                        <div class="bg-light p-3 rounded">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">
                                    <Icon Name="IconName.List" class="me-1" />
                                    Subtemas de "@context.Nombre"
                                </h6>
                                @if (AuthState.UserHasPermission("SUBTEMAS_WRITE"))
                                {
                                    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => AbrirModalAltaSubtema()">
                                        <Icon Name="IconName.Plus" class="me-1" />
                                        Agregar Subtema
                                    </Button>
                                }
                            </div>
                            <!--
                             <Grid @ref="gridSubtema"
                                  TItem="SubtemaDTO"
                                  AllowRowClick="true"
                                  Class="table table-hover border-top table-sm"
                                  Data="GetSubtemas(context.IdTema)"
                                  OnRowClick="OnRowClick"
                                  OnRowDoubleClick="OnSubtemaDobleClick">

                                <GridColumns>
                                    <GridColumn TItem="SubtemaDTO" Context="subtema" HeaderText="ID" PropertyName="IdSubtema">
                                        @subtema.IdSubtema
                                    </GridColumn>
                                    <GridColumn TItem="SubtemaDTO" Context="subtema" HeaderText="Nombre" PropertyName="Nombre">
                                        @subtema.Nombre
                                    </GridColumn>
                                    <GridColumn TItem="SubtemaDTO" Context="subtema" HeaderText="Orden" PropertyName="Orden">
                                        <span class="badge bg-info">@subtema.Orden</span>
                                    </GridColumn>
                                    @if (AuthState.UserHasPermission("TEMAS_WRITE"))
                                    {
                                        <GridColumn TItem="SubtemaDTO" Context="subtema" HeaderText="Acciones">
                                            <Button Color="ButtonColor.Primary" Size="ButtonSize.ExtraSmall" @onclick="() => EditarSubtema(subtema)">
                                                <Icon Name="IconName.Pencil" />
                                            </Button>
                                        </GridColumn>
                                    }
                                </GridColumns>
                            </Grid> -->
                        </div>
                    </GridDetailView>
                </Grid>
            </div>
        </div>

        <!-- Modal para Alta de Tema -->
        <Modal @ref="_AltaSubtema" UseStaticBackdrop="true" CloseOnEscape="false" Size="ModalSize.Large" />

        <!-- Modal para Edición de Tema -->
        <Modal @ref="_EdicionSubtema" UseStaticBackdrop="true" CloseOnEscape="false" Size="ModalSize.Large" />

     
        <!-- Información adicional para usuarios sin permisos de escritura -->
        @if (!AuthState.UserHasPermission("SUBTEMAS_WRITE"))
        {
            <div class="alert alert-info mt-3">
                <Icon Name="IconName.InfoCircle" class="me-2" />
                <strong>Modo solo lectura:</strong> Puedes consultarsubtemas, pero no realizar modificaciones.
            </div>
        }
    </div>
</WebGrillaBlazor.Components.AuthorizeView>

@code {
