@using WebGrillaBlazor.DTOs
@using WebGrillaBlazor.ApiClient

@inject ApiClientGeneric<TipoDocumentoDTO> _apiClient

<EditForm EditContext="@editContext" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Id:</label>
        <label class="col-md-10">
            @if (tipoDocumento.IdTipoDocumento > 0)
            {
                <text>@tipoDocumento.IdTipoDocumento</text>
            }
            else
            {
                <span class="text-muted fst-italic">Se asignará automáticamente</span>
            }
        </label>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Nombre:</label>
        <div class="col-md-10">
            <TextInput @bind-Value="@tipoDocumento.Nombre" Placeholder="Ingrese el nombre del tipo de documento"></TextInput>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Abreviación:</label>
        <div class="col-md-10">
            <TextInput @bind-Value="@tipoDocumento.Abreviacion" Placeholder="Ingrese la abreviación"></TextInput>
        </div>
    </div>

</EditForm>

<div class="row">
    <div class="col-md-12 text-right">
        <Button Type="ButtonType.Button" Color="ButtonColor.Success" @onclick="GrabarTipoDocumento">Grabar</Button>
        @if (!_esNuevo)
        {
            <Button Type="ButtonType.Button" Color="ButtonColor.Warning" @onclick="EliminarTipoDocumento">Eliminar</Button>
        }
        <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="OnClickCallBack"> Cerrar</Button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="row mt-3">
        <Alert Color="AlertColor.Danger">@errorMessage</Alert>
    </div>
}

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallBack { get; set; }
    [Parameter] public TipoDocumentoDTO tipoDocumento { get; set; }
    private EditContext editContext;

    private string errorMessage = "";
    private System.Timers.Timer _timer;
    private bool _esNuevo = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"OnInitializedAsync() idTipoDocumento: {tipoDocumento.IdTipoDocumento}");

        editContext = new EditContext(tipoDocumento);

        // Determinar si es un registro nuevo (Id = 0) o existente
        _esNuevo = tipoDocumento.IdTipoDocumento == 0;

        Console.WriteLine($"OnInitializedAsync() esNuevo: {_esNuevo}");

        await base.OnInitializedAsync();
    }

    public void HandleOnValidSubmit()
    {
        if (editContext.Validate())
        {
            Console.WriteLine("Form submitted successfully");
        }
    }

    private async Task GrabarTipoDocumento()
    {
        // Validar campos requeridos
        if (string.IsNullOrWhiteSpace(tipoDocumento.Nombre))
        {
            errorMessage = "Debe ingresar un nombre para el tipo de documento";
            return;
        }

        errorMessage = "";

        try
        {
            if (_esNuevo)
            {
                Console.WriteLine("AltaTipoDocumento()");
                var nuevo = await _apiClient.CreateAsync(tipoDocumento);
                tipoDocumento.IdTipoDocumento = nuevo.IdTipoDocumento;
                _esNuevo = false; // Ya no es nuevo después de crearlo
            }
            else
            {
                Console.WriteLine("ModificarTipoDocumento()");
                await _apiClient.UpdateAsync(tipoDocumento.IdTipoDocumento, tipoDocumento);
            }

            // Cerrar el modal después de grabar exitosamente
            if (OnClickCallBack.HasDelegate)
            {
                await OnClickCallBack.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task EliminarTipoDocumento()
    {
        if (_esNuevo || tipoDocumento.IdTipoDocumento == 0)
        {
            errorMessage = "No se puede eliminar un registro que no ha sido guardado";
            return;
        }

        try
        {
            Console.WriteLine("EliminarTipoDocumento()");
            await _apiClient.DeleteAsync(tipoDocumento.IdTipoDocumento);

            if (OnClickCallBack.HasDelegate)
            {
                await OnClickCallBack.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar tipo de documento: {ex.Message}";
        }
    }
}
